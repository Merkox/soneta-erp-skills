<?xml version="1.0" encoding="utf-8"?>
<!-- Lista w układzie tabelarycznym (XRTable) z bieżącej listy (CurrentList).
     - ReportHeaderBand: tytuł raportu (raz na początku).
     - PageHeaderBand: nagłówek kolumn, powtarzany na każdej stronie.
     - DetailBand: wiersz danych; kolumna Lp. = <Summary Func="RecordNumber">.
     - ReportFooterBand: suma kolumny Wartosc przez wyrażenie sumSum([Wartosc]).
     Szerokości kolumn ustawiane względnie atrybutem Weight (sumują się proporcjonalnie). -->
<XtraReportsLayoutSerializer SerializerVersion="20.2.7.0" Ref="1"
    ControlType="DevExpress.XtraReports.UI.XtraReport, DevExpress.XtraReports.v20.2"
    Name="ListaProsta" DisplayName="Lista towarów" SnapGridSize="25"
    ReportUnit="TenthsOfAMillimeter" Margins="198, 198, 200, 200"
    PaperKind="A4" PageWidth="2100" PageHeight="2970"
    Version="20.2" DataSource="#Ref-0" Dpi="254" Font="Calibri, 9pt">
  <Bands>
    <Item1 Ref="2" ControlType="TopMarginBand" Name="topMargin" HeightF="200" Dpi="254" />

    <Item2 Ref="3" ControlType="ReportHeaderBand" Name="reportHeader" HeightF="120" Dpi="254">
      <Controls>
        <Item1 Ref="4" ControlType="XRLabel" Name="lblTytul" Text="Lista towarów"
               SizeF="1704,90" LocationFloat="0,0" Font="Calibri, 16pt, style=Bold"
               TextAlignment="MiddleLeft" Dpi="254" Padding="5,5,0,0,254" />
      </Controls>
    </Item2>

    <Item3 Ref="5" ControlType="PageHeaderBand" Name="pageHeader" HeightF="70" Dpi="254">
      <Controls>
        <Item1 Ref="6" ControlType="XRTable" Name="tabelaNaglowek" AnchorHorizontal="Both"
               SizeF="1704,70" LocationFloat="0,0" Dpi="254">
          <Rows>
            <Item1 Ref="7" ControlType="XRTableRow" Name="wierszNaglowek" Weight="1" Dpi="254">
              <Cells>
                <Item1 Ref="8"  ControlType="XRTableCell" Name="hLp"      Weight="0.06" Text="Lp."     Font="Calibri, 9pt, style=Bold" TextAlignment="MiddleRight" Dpi="254" Padding="5,5,0,0,254" />
                <Item2 Ref="9"  ControlType="XRTableCell" Name="hKod"     Weight="0.20" Text="Kod"     Font="Calibri, 9pt, style=Bold" TextAlignment="MiddleLeft"  Dpi="254" Padding="5,5,0,0,254" />
                <Item3 Ref="10" ControlType="XRTableCell" Name="hNazwa"   Weight="0.54" Text="Nazwa"   Font="Calibri, 9pt, style=Bold" TextAlignment="MiddleLeft"  Dpi="254" Padding="5,5,0,0,254" />
                <Item4 Ref="11" ControlType="XRTableCell" Name="hWartosc" Weight="0.20" Text="Wartość" Font="Calibri, 9pt, style=Bold" TextAlignment="MiddleRight" Dpi="254" Padding="5,5,0,0,254" />
              </Cells>
            </Item1>
          </Rows>
        </Item1>
      </Controls>
    </Item3>

    <Item4 Ref="12" ControlType="DetailBand" Name="detail" HeightF="60" Dpi="254">
      <Controls>
        <Item1 Ref="13" ControlType="XRTable" Name="tabelaWiersz" AnchorHorizontal="Both"
               SizeF="1704,60" LocationFloat="0,0" Dpi="254">
          <Rows>
            <Item1 Ref="14" ControlType="XRTableRow" Name="wierszDane" Weight="1" Dpi="254">
              <Cells>
                <Item1 Ref="15" ControlType="XRTableCell" Name="cLp" Weight="0.06" TextAlignment="MiddleRight" Dpi="254" Padding="5,5,0,0,254">
                  <Summary Ref="16" Running="Report" Func="RecordNumber" />
                </Item1>
                <Item2 Ref="17" ControlType="XRTableCell" Name="cKod"     Weight="0.20" Text="[Kod]"     TextAlignment="MiddleLeft"  Dpi="254" Padding="5,5,0,0,254" />
                <Item3 Ref="18" ControlType="XRTableCell" Name="cNazwa"   Weight="0.54" Text="[Nazwa]"   TextAlignment="MiddleLeft"  Dpi="254" Padding="5,5,0,0,254" />
                <Item4 Ref="19" ControlType="XRTableCell" Name="cWartosc" Weight="0.20" Text="[Wartosc]" TextAlignment="MiddleRight" TextFormatString="{0:n2}" Dpi="254" Padding="5,5,0,0,254" />
              </Cells>
            </Item1>
          </Rows>
        </Item1>
      </Controls>
    </Item4>

    <Item5 Ref="20" ControlType="ReportFooterBand" Name="reportFooter" HeightF="70" Dpi="254">
      <Controls>
        <Item1 Ref="21" ControlType="XRTable" Name="tabelaStopka" AnchorHorizontal="Both"
               SizeF="1704,70" LocationFloat="0,0" Dpi="254">
          <Rows>
            <Item1 Ref="22" ControlType="XRTableRow" Name="wierszStopka" Weight="1" Dpi="254">
              <Cells>
                <Item1 Ref="23" ControlType="XRTableCell" Name="fLabel" Weight="0.80" Text="Razem:" Font="Calibri, 9pt, style=Bold" TextAlignment="MiddleRight" Dpi="254" Padding="5,5,0,0,254" />
                <Item2 Ref="24" ControlType="XRTableCell" Name="fSuma"  Weight="0.20" Font="Calibri, 9pt, style=Bold" TextAlignment="MiddleRight" TextFormatString="{0:n2}" Dpi="254" Padding="5,5,0,0,254">
                  <ExpressionBindings>
                    <Item1 Ref="25" EventName="BeforePrint" PropertyName="Text" Expression="sumSum([Wartosc])" />
                  </ExpressionBindings>
                </Item2>
              </Cells>
            </Item1>
          </Rows>
        </Item1>
      </Controls>
    </Item5>

    <Item6 Ref="26" ControlType="BottomMarginBand" Name="bottomMargin" HeightF="200" Dpi="254" />
  </Bands>
  <ComponentStorage>
    <Item1 Ref="0" ObjectType="Soneta.Business.UI.DxReports.BusinessDataSource,Soneta.Business.UI.DxReports"
           Name="BusinessSource" DataKind="CurrentList" />
    <Item2 Ref="27" ObjectType="Soneta.Business.UI.DxReports.Components.BusinessContext,Soneta.Business.UI.DxReports"
           Name="BusinessContext" StylesSource="standardowy" TreatStringAsValueInExport="false" />
  </ComponentStorage>
</XtraReportsLayoutSerializer>
