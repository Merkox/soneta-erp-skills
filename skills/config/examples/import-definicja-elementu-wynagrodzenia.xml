    <!-- Kod C# wprost w treści; znaki < > &amp; jako encje XML. Białe znaki są znaczące. -->
    <Tekst>
public void %NAZWA%_Param(%TYP% Element, WypSkladnik Składnik) {
    // podstawa: wynagrodzenie zasadnicze nominalne na koniec okresu
    Składnik.Podstawa1 = ZasadniczeNominalne(Element.Okres.To);

    // procent wg stażu pracy (staż razem, liczony na pierwszy dzień okresu)
    int lata = Element.Pracownik.StażPracy(Element.Okres.From).Lata;
    if (lata &lt; 5)       Składnik.Procent = 0;
    else if (lata &lt; 10) Składnik.Procent = 5;
    else if (lata &lt; 20) Składnik.Procent = 10;
    else                 Składnik.Procent = 20;
}

public Currency %NAZWA%_Wylicz(%TYP% Element, WypSkladnik Składnik) {
    return Składnik.Podstawa1 * Składnik.Procent / 100;
}
    </Tekst>
